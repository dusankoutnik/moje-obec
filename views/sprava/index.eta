<% layout('/layout') %>
<h1><%= it.t('sprava.titulek') %></h1>
<div class="karty">
  <% if (it.jeSpravce) { %>
  <article class="karta"><h2><a href="/sprava/uzivatele"><%= it.t('sprava.uzivatele') %></a></h2><p><%= it.t('sprava.uzivatele_text') %></p><p class="cislo"><%= it.t('sprava.pocet', { n: it.pocet }) %></p></article>
  <% } %>
  <% if (it.jeRedaktor && it.obecStaticka.moduly.infokanal) { %>
  <article class="karta"><h2><a href="/infokanal/sprava"><%= it.obec.texty.nazev_infokanalu %></a></h2><p><%= it.t('sprava.infokanal_text') %></p><a class="tlacitko" href="/infokanal/sprava/nove"><%= it.t('infokanal.nove_hlaseni') %></a></article>
  <% } %>
  <% if (it.jeWeb && it.obec.moduly.web) { %>
  <article class="karta"><h2><a href="/sprava/web"><%= it.t('web.sprava_titulek') %></a></h2><p><%= it.t('sprava.web_text') %></p><% if (it.akceKeZpracovani) { %><p class="cislo"><a href="/sprava/web/akce/zpracovani"><%= it.t('propojeni.dashboard', { n: it.akceKeZpracovani }) %></a></p><% } %><a class="tlacitko" href="/sprava/web/novy?typ=aktualita"><%= it.t('web.napsat_aktualitu') %></a></article>
  <% } %>
  <% if (it.jeSpravce && it.obec.moduly.web) { %>
  <article class="karta"><h2><a href="/sprava/web/vzhled">🎨 <%= it.t('web.vzhled') %></a></h2><p><%= it.t('web.vzhled_text') %></p><a class="tlacitko" href="/sprava/web/vzhled"><%= it.t('web.vzhled_zmenit') %></a></article>
  <% } %>
  <% if (it.jeDeska && it.obec.moduly.deska) { %>
  <article class="karta"><h2><a href="/sprava/deska"><%= it.t('deska.titulek') %></a></h2><p><%= it.t('sprava.deska_text') %></p><a class="tlacitko" href="/sprava/deska/novy"><%= it.t('deska.novy') %></a><% if (it.jeSpravce) { %> <a href="/sprava/povinne-informace"><%= it.t('pi.titulek') %></a><% } %></article>
  <% } %>
  <% if (it.textDokumentu && (it.textDokumentu.ceka || it.textDokumentu.pocty.chyba)) { %>
  <article class="karta" id="text-dokumentu"><h2><a href="/sprava/web/text-dokumentu">🔎 <%= it.t('text.titulek') %></a></h2><p><%= it.t('text.hledame_i_dokumenty') %></p><p class="cislo"><%= it.t('text.dashboard', { ceka: it.textDokumentu.ceka, chyby: it.textDokumentu.pocty.chyba }) %></p></article>
  <% } %>
  <% if (it.podatelnaNevyrizene !== null && it.podatelnaNevyrizene !== undefined) { %>
  <article class="karta"><h2><a href="/sprava/podatelna">📨 <%= it.t('podatelna.titulek') %></a></h2><p><%= it.t('sprava.podatelna_text') %></p><p class="cislo"><%= it.t('sprava.podatelna_nevyrizene', { n: it.podatelnaNevyrizene }) %></p></article>
  <% } %>
  <% if (it.jeKviz && it.obecStaticka.moduly.kviz) { %>
  <article class="karta"><h2><a href="/sprava/kviz">🧠 <%= it.t('kviz.sprava_titulek') %></a></h2><p><%= it.t('kviz.sprava_karta') %></p><a class="tlacitko" href="/kviz"><%= it.t('kviz.hrat') %></a></article>
  <% } %>
  <% if (it.sms) { %>
  <article class="karta" id="sms-prehled"><h2><%= it.t('sprava.sms_nadpis') %></h2>
    <p class="cislo"><%= it.sms.limit > 0 ? it.t('sprava.sms_kody', { n: it.sms.kodu24h, limit: it.sms.limit }) : it.t('sprava.sms_kody_bez_limitu', { n: it.sms.kodu24h }) %></p>
    <% if (it.sms.limit > 0) { %><meter min="0" max="<%= it.sms.limit %>" high="<%= Math.ceil(it.sms.limit * 0.8) %>" value="<%= Math.min(it.sms.kodu24h, it.sms.limit) %>" aria-label="<%= it.t('sprava.sms_kody', { n: it.sms.kodu24h, limit: it.sms.limit }) %>"></meter><% } %>
    <% if (it.sms.vycerpano) { %><p class="flash flash-chyba" role="status"><%= it.t('sprava.sms_vycerpano', { datum: it.fmtDatum(it.sms.vycerpano.at), n: it.sms.vycerpano.pocet }) %></p><% } %>
    <% if (it.sms.fronta) { %>
    <p><%= it.t('sprava.sms_fronta', { kanal: it.obec.texty.nazev_infokanalu }) %>:
      <%= it.t('sprava.sms_ceka') %> <strong><%= it.sms.fronta.ceka %></strong> ·
      <%= it.t('sprava.sms_odesila') %> <strong><%= it.sms.fronta.odesilaSe %></strong> ·
      <%= it.t('sprava.sms_odeslano') %> <strong><%= it.sms.fronta.odeslano24h %></strong> ·
      <%= it.t('sprava.sms_vzdano') %> <strong><%= it.sms.fronta.vzdano24h %></strong></p>
    <% } %>
  </article>
  <% } %>
  <% const A = it.aplikace; if (A) { const S = A.souhrn; %>
  <% if (A.ucty) { %>
  <article class="karta" id="schvalovani"><h2><a href="/sprava/schvalovani">🕐 Schvalování</a></h2><p>Žádosti o rezervace a posilovnu, nové účty k posouzení rezidenta, účty bez jména.</p>
    <p class="cislo"><% if (S) { %><%= S.pending %> rezervací · <%= S.gymRequested %> posilovna · <% } %><%= A.ucty.kPosouzeni %> k posouzení · <%= A.ucty.bezJmena %> bez jména</p></article>
  <article class="karta"><h2><a href="/sprava/statistiky">📈 Statistiky</a></h2><p>Souhrnná čísla účtů a aplikací — jen agregáty, bez jmen.</p></article>
  <% } %>
  <% if (A.rezervace) { %>
  <% if (A.spravce) { %>
  <article class="karta"><h2><a href="/rezervace/admin/rezervace">📅 Rezervace</a></h2><p>Přehled a úpravy rezervací.</p><% if (S) { %><p class="cislo"><%= S.future %> nadcházejících</p><% } %></article>
  <article class="karta"><h2><a href="/rezervace/admin/uzivatele">👥 Uživatelé rezervací</a></h2><p>Rezidenti, posilovna, zámky a čipy.</p><% if (S) { %><p class="cislo"><%= S.users %> účtů</p><% } %></article>
  <% if (A.spolujizda) { %><article class="karta"><h2><a href="/rezervace/admin/spolujizda">🚗 Spolujízda</a></h2><p>Jízdy a poptávky.</p><% if (S) { %><p class="cislo"><%= S.trips %> nadcházejících jízd</p><% } %></article><% } %>
  <% } %>
  <% if (A.spravce || A.ucetni) { %>
  <article class="karta"><h2><a href="/rezervace/admin/vyuctovani">💰 Vyúčtování</a></h2><p>Výzvy k úhradě a platby.</p><% if (S) { %><p class="cislo"><%= S.unpaid.c %> nezaplaceno (<%= Math.round(S.unpaid.s).toLocaleString('cs-CZ') %> Kč)</p><% } %></article>
  <% if (A.predprodej) { %><article class="karta"><h2><a href="/rezervace/admin/predprodej">🎫 Předprodej</a></h2><p>Vstupenky a potvrzování plateb.</p><% if (S) { %><p class="cislo"><%= S.tickets.paid %> prodáno · <%= S.tickets.held %> čeká na platbu</p><% } %></article><% } %>
  <article class="karta"><h2><a href="/rezervace/admin/report">📊 Report</a></h2><p>Výnosy, rozpočtová skladba, pohledávky.</p></article>
  <article class="karta"><h2><a href="/rezervace/admin/cenik">🏷️ Ceník</a></h2><p>Ceny a rozpočtové kódy.</p></article>
  <% if (!A.spravce) { %><article class="karta"><h2><a href="/rezervace/admin/uzivatele">👥 Uživatelé rezervací</a></h2><p>Evidence zámků a čipů.</p></article><% } %>
  <% } %>
  <% if (!S) { %><p class="napoveda" role="status">Rezervace teď neodpovídají — počty se ukážou, až zase poběží.</p><% } %>
  <% } %>
  <% } %>
  <% if (it.jeSpravce) { %>
  <article class="karta"><h2><a href="/sprava/audit"><%= it.t('sprava.audit') %></a></h2><p><%= it.t('sprava.audit_text') %></p></article>
  <% } %>
  <% if (it.uzivatel.role.includes('admin')) { %>
  <article class="karta"><h2><a href="/sprava/moduly">🧩 <%= it.t('moduly_obce.titulek') %></a></h2><p><%= it.t('moduly_obce.karta') %></p></article>
  <article class="karta"><h2><a href="/sprava/api">🔌 API a integrace</a></h2><p>Tokeny pro programy, které na web samy zapisují (zpravodaj, kalendář).</p></article>
  <% } %>
  <% if (it.uzivatel.role.includes('admin')) { %>
  <article class="karta"><h2><a href="/sprava/klienti"><%= it.t('sprava.klienti') %></a></h2><p><%= it.t('sprava.klienti_text') %></p></article>
  <% } %>
</div>
