<% layout('/layout') %>
<%
  // Přehled administrace (2026-10-23, Dušan): malé dlaždice rozdělené do skupin; prázdná skupina se nevypisuje.
  // Dlaždice: { ikona, nazev, href, popis, cislo?, akce?: { href, text }, id? }
  var t = it.t, A = it.aplikace, S = A ? A.souhrn : null;
  var skupiny = [];
  function skupina(nazev, dl, pod) { dl = dl.filter(Boolean); if (dl.length || pod) skupiny.push({ nazev: nazev, dl: dl, pod: pod }); }
  var maRez = A && A.rezervace, rezSpravce = maRez && A.spravce, rezFinance = maRez && (A.spravce || A.ucetni);

  skupina('K vyřízení', [
    A && A.ucty ? { id: 'schvalovani', ikona: '🕐', nazev: 'Schvalování', href: '/sprava/schvalovani', popis: 'Žádosti o rezervace a posilovnu, nové účty k posouzení, účty bez jména.',
      cislo: (S ? S.pending + ' rezervací · ' + S.gymRequested + ' posilovna · ' : '') + A.ucty.kPosouzeni + ' k posouzení · ' + A.ucty.bezJmena + ' bez jména' } : null,
    A && A.ucty ? { ikona: '📞', nazev: 'Změny telefonu', href: '/sprava/ucty/zmeny-telefonu', popis: 'Žádosti o změnu přihlašovacího telefonu.' } : null,
    it.podatelnaNevyrizene !== null && it.podatelnaNevyrizene !== undefined ? { ikona: '📨', nazev: t('podatelna.titulek'), href: '/sprava/podatelna', popis: t('sprava.podatelna_text'), cislo: t('sprava.podatelna_nevyrizene', { n: it.podatelnaNevyrizene }) } : null,
    it.jeWeb && it.obec.moduly.web && it.akceKeZpracovani ? { ikona: '📆', nazev: 'Akce ke zpracování', href: '/sprava/web/akce/zpracovani', popis: 'Veřejné rezervace, ze kterých může vzniknout pozvánka.', cislo: t('propojeni.dashboard', { n: it.akceKeZpracovani }) } : null,
    it.textDokumentu && (it.textDokumentu.ceka || it.textDokumentu.pocty.chyba) ? { id: 'text-dokumentu', ikona: '🔎', nazev: t('text.titulek'), href: '/sprava/web/text-dokumentu', popis: t('text.hledame_i_dokumenty'), cislo: t('text.dashboard', { ceka: it.textDokumentu.ceka, chyby: it.textDokumentu.pocty.chyba }) } : null,
  ]);

  skupina('Obsah webu', [
    it.jeWeb && it.obec.moduly.web ? { ikona: '📰', nazev: t('web.sprava_titulek'), href: '/sprava/web', popis: t('sprava.web_text'), akce: { href: '/sprava/web/novy?typ=aktualita', text: t('web.napsat_aktualitu') } } : null,
    it.jeDeska && it.obec.moduly.deska ? { ikona: '📋', nazev: t('deska.titulek'), href: '/sprava/deska', popis: t('sprava.deska_text'), akce: { href: '/sprava/deska/novy', text: t('deska.novy') } } : null,
    it.jeDeska && it.jeSpravce && it.obec.moduly.deska ? { ikona: '⚖️', nazev: t('pi.titulek'), href: '/sprava/povinne-informace', popis: 'Struktura podle vyhlášky 515/2020 Sb.' } : null,
    it.jeWeb && it.obec.moduly.web ? { ikona: '☎️', nazev: t('web.kontakt_obce'), href: '/sprava/web/kontakt', popis: t('web.kontakt_obce_text') } : null,
    it.jeSpravce && it.obec.moduly.web ? { ikona: '🎨', nazev: t('web.vzhled'), href: '/sprava/web/vzhled', popis: t('web.vzhled_text') } : null,
    it.jeKviz && it.obecStaticka.moduly.kviz ? { ikona: '🧠', nazev: t('kviz.sprava_titulek'), href: '/sprava/kviz', popis: t('kviz.sprava_karta') } : null,
  ]);

  skupina('Zprávy občanům', [
    it.jeRedaktor && it.obecStaticka.moduly.infokanal ? { ikona: '📣', nazev: it.obec.texty.nazev_infokanalu, href: '/infokanal/sprava', popis: t('sprava.infokanal_text'), akce: { href: '/infokanal/sprava/nove', text: t('infokanal.nove_hlaseni') } } : null,
  ], !!it.sms);

  skupina('Rezervace a služby', [
    rezFinance ? { ikona: '🛡️', nazev: t('sprava.admin_rezervaci'), href: '/rezervace/admin', popis: 'Úvod administrace rezervací se všemi sekcemi.' } : null,
    rezSpravce ? { ikona: '🧰', nazev: 'Věci a prostory', href: '/rezervace/admin/zdroje', popis: 'Co se půjčuje: přidat, přejmenovat, kusy, skrýt.' } : null,
    rezSpravce ? { ikona: '📅', nazev: 'Rezervace', href: '/rezervace/admin/rezervace', popis: 'Přehled a úpravy rezervací.', cislo: S ? S.future + ' nadcházejících' : '' } : null,
    rezSpravce ? { ikona: '👥', nazev: 'Uživatelé rezervací', href: '/rezervace/admin/uzivatele', popis: 'Rezidenti, posilovna, zámky a čipy.', cislo: S ? S.users + ' účtů' : '' } : null,
    rezSpravce && A.spolujizda ? { ikona: '🚗', nazev: 'Spolujízda', href: '/rezervace/admin/spolujizda', popis: 'Jízdy a poptávky.', cislo: S ? S.trips + ' nadcházejících jízd' : '' } : null,
    rezFinance && A.predprodej ? { ikona: '🎫', nazev: 'Předprodej', href: '/rezervace/admin/predprodej', popis: 'Vstupenky a potvrzování plateb.', cislo: S ? S.tickets.paid + ' prodáno · ' + S.tickets.held + ' čeká na platbu' : '' } : null,
    maRez && !A.spravce && A.ucetni ? { ikona: '👥', nazev: 'Uživatelé rezervací', href: '/rezervace/admin/uzivatele', popis: 'Evidence zámků a čipů.' } : null,
  ]);

  skupina('Finance', [
    rezFinance ? { ikona: '💰', nazev: 'Vyúčtování', href: '/rezervace/admin/vyuctovani', popis: 'Výzvy k úhradě a platby.', cislo: S ? S.unpaid.c + ' nezaplaceno (' + Math.round(S.unpaid.s).toLocaleString('cs-CZ') + ' Kč)' : '' } : null,
    rezFinance ? { ikona: '📊', nazev: 'Report', href: '/rezervace/admin/report', popis: 'Výnosy, rozpočtová skladba, pohledávky.' } : null,
    rezFinance ? { ikona: '🏷️', nazev: 'Ceník', href: '/rezervace/admin/cenik', popis: 'Ceny a rozpočtové kódy.' } : null,
  ]);

  skupina('Lidé a účty', [
    it.jeSpravce ? { ikona: '🪪', nazev: t('sprava.uzivatele'), href: '/sprava/uzivatele', popis: t('sprava.uzivatele_text'), cislo: t('sprava.pocet', { n: it.pocet }) } : null,
    A && A.ucty ? { ikona: '📈', nazev: 'Statistiky', href: '/sprava/statistiky', popis: 'Souhrnná čísla účtů a aplikací — bez jmen.' } : null,
  ]);

  var jeAdmin = it.uzivatel.role.includes('admin');
  skupina('Systém', [
    jeAdmin ? { ikona: '🧩', nazev: t('moduly_obce.titulek'), href: '/sprava/moduly', popis: t('moduly_obce.karta') } : null,
    jeAdmin ? { ikona: '🔌', nazev: 'API a integrace', href: '/sprava/api', popis: 'Tokeny pro programy, které na web samy zapisují.' } : null,
    jeAdmin ? { ikona: '🔐', nazev: t('sprava.klienti'), href: '/sprava/klienti', popis: t('sprava.klienti_text') } : null,
    it.jeSpravce ? { ikona: '🧾', nazev: t('sprava.audit'), href: '/sprava/audit', popis: t('sprava.audit_text') } : null,
  ]);
%>
<h1><%= t('sprava.titulek') %></h1>
<% if (maRez && !S) { %><p class="napoveda" role="status">Rezervace teď neodpovídají — počty se ukážou, až zase poběží.</p><% } %>
<% skupiny.forEach(function (g) { %>
<section class="sprava-skupina" aria-label="<%= g.nazev %>">
  <h2><%= g.nazev %></h2>
  <% if (g.dl.length || (g.pod && it.sms)) { %>
  <ul class="dlazdice-mini">
    <% g.dl.forEach(function (d) { %>
    <li<% if (d.id) { %> id="<%= d.id %>"<% } %>>
      <a class="dm-hlavni" href="<%= d.href %>"><span class="dm-ikona" aria-hidden="true"><%= d.ikona %></span><span class="dm-nazev"><%= d.nazev %></span></a>
      <span class="dm-popis"><%= d.popis %></span>
      <% if (d.cislo) { %><span class="dm-cislo"><%= d.cislo %></span><% } %>
      <% if (d.akce) { %><a class="dm-akce" href="<%= d.akce.href %>">+ <%= d.akce.text %></a><% } %>
    </li>
    <% }) %>
    <% if (g.pod && it.sms) { %>
    <li class="dm-siroka" id="sms-prehled">
      <span class="dm-hlavni dm-bez-odkazu"><span class="dm-ikona" aria-hidden="true">📱</span><span class="dm-nazev"><%= t('sprava.sms_nadpis') %></span></span>
      <span class="dm-popis">Přihlašovací kódy poslané za posledních 24 hodin (denní limit chrání před zneužitím) a stav rozesílky hlášení.</span>
      <span class="dm-cislo"><%= it.sms.limit > 0 ? t('sprava.sms_kody', { n: it.sms.kodu24h, limit: it.sms.limit }) : t('sprava.sms_kody_bez_limitu', { n: it.sms.kodu24h }) %></span>
      <% if (it.sms.limit > 0) { %><meter min="0" max="<%= it.sms.limit %>" high="<%= Math.ceil(it.sms.limit * 0.8) %>" value="<%= Math.min(it.sms.kodu24h, it.sms.limit) %>" aria-label="<%= t('sprava.sms_kody', { n: it.sms.kodu24h, limit: it.sms.limit }) %>"></meter><% } %>
      <% if (it.sms.vycerpano) { %><span class="flash flash-chyba" role="status"><%= t('sprava.sms_vycerpano', { datum: it.fmtDatum(it.sms.vycerpano.at), n: it.sms.vycerpano.pocet }) %></span><% } %>
      <% if (it.sms.fronta) { %><span class="dm-popis"><%= t('sprava.sms_fronta', { kanal: it.obec.texty.nazev_infokanalu }) %>: <%= t('sprava.sms_ceka') %> <strong><%= it.sms.fronta.ceka %></strong> · <%= t('sprava.sms_odesila') %> <strong><%= it.sms.fronta.odesilaSe %></strong> · <%= t('sprava.sms_odeslano') %> <strong><%= it.sms.fronta.odeslano24h %></strong> · <%= t('sprava.sms_vzdano') %> <strong><%= it.sms.fronta.vzdano24h %></strong></span><% } %>
    </li>
    <% } %>
  </ul>
  <% } %>
</section>
<% }) %>
