<% layout('/layout') %>
<div class="prihlaseni">
<h1><%= it.t('prihlaseni.titulek') %></h1>
<p><%= it.t('prihlaseni.perex') %></p>
<div class="prihlaseni-mrizka">
  <section class="prihlaseni-box" aria-labelledby="ph-tel">
    <h2 id="ph-tel"><%= it.t('prihlaseni.telefonem_nadpis') %></h2>
    <p class="napoveda"><%= it.t('prihlaseni.telefonem_text') %></p>
    <% if (it.chyba) { %><div class="flash flash-chyba" role="alert"><%= it.chyba %></div><% } %>
    <form method="post" action="/oidc/interaction/<%= it.uid %>/telefon" class="formular">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <label for="telefon"><%= it.t('prihlaseni.telefon') %></label>
      <input id="telefon" name="telefon" type="tel" inputmode="tel" autocomplete="tel" required <%= it.chybaEmail ? '' : 'autofocus' %> value="<%= it.telefon || '' %>" aria-describedby="telefon-napoveda">
      <p class="napoveda" id="telefon-napoveda"><%= it.t('prihlaseni.telefon_napoveda') %></p>
      <button class="tlacitko" type="submit"><%= it.t('prihlaseni.poslat_kod') %></button>
    </form>
  </section>
  <section class="prihlaseni-box" aria-labelledby="ph-email">
    <h2 id="ph-email"><%= it.t('prihlaseni.emailem_nadpis') %></h2>
    <p class="napoveda"><%= it.t('prihlaseni.emailem_text') %></p>
    <% if (it.chybaEmail) { %><div class="flash flash-chyba" role="alert"><%= it.chybaEmail %></div><% } %>
    <form method="post" action="/oidc/interaction/<%= it.uid %>/heslo" class="formular">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <label for="email"><%= it.t('prihlaseni.email') %></label>
      <input id="email" name="email" type="email" autocomplete="username" required <%= it.chybaEmail ? 'autofocus' : '' %> value="<%= it.email || '' %>">
      <label for="heslo"><%= it.t('prihlaseni.heslo') %></label>
      <input id="heslo" name="heslo" type="password" autocomplete="current-password" required>
      <div class="tlacitka-rada">
        <button class="tlacitko sekundarni" type="submit" formaction="/oidc/interaction/<%= it.uid %>/email-kod" formnovalidate><%= it.t('prihlaseni.neznam_heslo') %></button>
        <button class="tlacitko" type="submit"><%= it.t('prihlaseni.overit') %></button>
      </div>
    </form>
  </section>
</div>
<p class="alternativa"><a href="/oidc/interaction/<%= it.uid %>/zrusit"><%= it.t('app.zrusit') %></a></p>
</div>
