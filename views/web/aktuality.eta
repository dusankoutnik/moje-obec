<% layout('/layout') %>
<h1><%= it.t('web.aktuality') %><% if (it.rubrikaCesta.length) { %><span class="vh">: </span><small class="rubrika-cesta"><%= it.rubrikaCesta.map(function (x) { return x.nazev; }).join(' › ') %></small><% } %></h1>
<% if (it.kategorie.length) { %>
<nav class="stitky-filtr" aria-label="<%= it.t('web.kategorie') %>">
  <a href="/aktuality" <%= !it.aktivni ? 'aria-current=page' : '' %>><%= it.t('deska.vse') %></a>
  <% it.kategorie.forEach(function (k) { %><a href="/aktuality?kategorie=<%= k.slug %>" <%= it.aktivni === k.slug ? 'aria-current=page' : (it.aktivniKoren === k.slug ? 'class=v-ceste' : '') %>><%= k.nazev %></a><% }) %>
</nav>
<% } %>
<% if (it.rubrikaCesta.length > 1 || it.podrubriky.length) { %>
<nav class="stitky-filtr podrubriky" aria-label="<%= it.t('web.podrubriky') %>">
  <% it.rubrikaCesta.slice(1).forEach(function (k) { %><a href="/aktuality?kategorie=<%= k.slug %>" <%= it.aktivni === k.slug ? 'aria-current=page' : 'class=v-ceste' %>><%= k.nazev %></a><% }) %>
  <% it.podrubriky.forEach(function (k) { %><a href="/aktuality?kategorie=<%= k.slug %>"><%= k.nazev %></a><% }) %>
</nav>
<% } %>
<% if (!it.radky.length) { %><p class="prazdne"><%= it.t('web.zadne_aktuality') %></p><% } %>
<div class="karty-clanku seznam-clanku">
  <% it.radky.forEach(function (a) { %><%~ include('/web/_karta-aktuality', { a: a, obr: it.obr, fmtDatum: it.fmtDatum, zkrat: it.zkrat, t: it.t, h: 2 }) %><% }) %>
</div>
<%~ include('/_strankovani', { s: it.strankovani, t: it.t }) %>
<p class="odkazy-pod"><a href="/aktuality/rss.xml"><%= it.t('deska.rss') %></a></p>
