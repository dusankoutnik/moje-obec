<% /* dlaždice počasí na titulce: it.pocasi = { stav, vystrahy, ted }, it.varianta = 'sklo' (úvod) | 'karta' (pod odkazy),
      it.idp = předpona id (dlaždice může být na stránce dvakrát — v úvodu pro počítač a pod odkazy pro telefon) */ %>
<% const s = it.pocasi.stav, ted = it.pocasi.ted, dny = s.dny, dnes = dny[0], h = s.ted %>
<section class="pocasi-dlazdice pocasi-<%= it.varianta %><%= it.trida ? ' ' + it.trida : '' %>" aria-labelledby="<%= it.idp %>-h">
  <% if (it.pocasi.vystrahy.length) { %><%~ include('/pocasi/_vystraha', Object.assign({}, it, { v: it.pocasi.vystrahy[0] })) %><% } %>
  <h2 id="<%= it.idp %>-h"><%= it.t('pocasi.nadpis_dlazdice') %> <span class="poc-misto"><%= s.nazev %></span></h2>
  <div class="poc-obsah">
    <div class="poc-dnes">
      <img src="/static/img/pocasi/<%= h.symbol || 'cloudy' %>.svg" alt="" width="72" height="72">
      <div>
        <p class="poc-den-nazev"><%= it.t('pocasi.ted') %></p>
        <p class="poc-teplota"><%= it.fmtTeplota(h.teplota) %></p>
        <p class="poc-popis"><%= h.popis %></p>
        <% if (dnes) { %><p class="poc-detail"><%= it.t('pocasi.dnes') %>: <%= it.t('pocasi.max_min', { max: it.fmtTeplota(dnes.max), min: it.fmtTeplota(dnes.min) }) %><br><%= it.t('pocasi.srazky') %> <%= it.fmtSrazky(dnes.srazky) %> · <%= it.t('pocasi.vitr') %> <%= it.t('pocasi.vitr_hodnota', { n: dnes.vitrMax === null ? '–' : dnes.vitrMax }) %></p><% } %>
      </div>
    </div>
    <ul class="poc-dalsi">
      <% dny.slice(1, 3).forEach(function (d, i) { %>
      <li class="<%= i === 1 ? 'poc-pozitri' : '' %>">
        <p class="poc-den-nazev"><%= it.nazevDne(d, ted, it.t) %></p>
        <img src="/static/img/pocasi/<%= d.symbol %>.svg" alt="<%= d.popis %>" width="44" height="44">
        <p class="poc-maxmin"><span class="vh"><%= it.t('pocasi.nejvys') %> </span><strong><%= it.fmtTeplota(d.max) %></strong> <span class="vh"><%= it.t('pocasi.nejniz') %> </span><span class="poc-min"><%= it.fmtTeplota(d.min) %></span></p>
        <p class="poc-detail"><span class="vh"><%= it.t('pocasi.srazky') %> </span><%= it.fmtSrazky(d.srazky) %></p>
      </li>
      <% }) %>
    </ul>
  </div>
  <p class="poc-dal"><a href="/pocasi"><%= it.t('pocasi.na_7_dni') %> <span aria-hidden="true">›</span></a>
    <span class="poc-zdroj"><%= it.t('pocasi.zdroj') %><% if (s.aktualizovano) { %> · <%= it.t('pocasi.aktualizovano', { kdy: it.fmtHodina(s.aktualizovano) }) %><% } %></span></p>
</section>
