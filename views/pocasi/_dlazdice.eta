<% /* dlaždice počasí na titulce: it.pocasi = { stav, vystrahy, ted }, it.varianta = 'sklo' (úvod) | 'karta' (pod odkazy),
      it.idp = předpona id (dlaždice může být na stránce dvakrát — v úvodu pro počítač a pod odkazy pro telefon) */ %>
<% const s = it.pocasi.stav, ted = it.pocasi.ted, dny = s.dny, dnes = dny[0], h = s.ted %>
<% /* „nebe“ podle počasí teď (jako widget v telefonu): barva pozadí + jemná animace, jen dekorace */ %>
<% const sym = h.symbol || 'cloudy', noc = /_night$/.test(sym) %>
<% const nebe = /thunder/.test(sym) ? 'bourka' : /snow|sleet/.test(sym) ? 'snih' : /rain/.test(sym) ? 'dest' : /fog/.test(sym) ? 'mlha' : /^clearsky/.test(sym) ? (noc ? 'jasno-noc' : 'jasno-den') : /^(fair|partlycloudy)/.test(sym) ? (noc ? 'polojasno-noc' : 'polojasno-den') : 'zatazeno' %>
<section class="pocasi-dlazdice pocasi-<%= it.varianta %><%= it.trida ? ' ' + it.trida : '' %> poc-nebe poc-nebe-<%= nebe %>" data-scena="<%= nebe %>" data-oblacnost="<%= h.oblacnost == null ? '' : Math.round(h.oblacnost) %>" data-srazky="<%= h.srazky == null ? '' : h.srazky %>" data-slunce="<%= s.astro.slunceVychod ? s.astro.slunceVychod.toISOString() : '' %> <%= s.astro.slunceZapad ? s.astro.slunceZapad.toISOString() : '' %>" data-mesic="<%= s.astro.mesicVychod ? s.astro.mesicVychod.toISOString() : '' %> <%= s.astro.mesicZapad ? s.astro.mesicZapad.toISOString() : '' %>" data-faze="<%= s.astro.fazeCislo %>" aria-labelledby="<%= it.idp %>-h">
  <div class="poc-nebe-vrstva" aria-hidden="true"></div>
  <% if (it.pocasi.vystrahy.length) { %><%~ include('/pocasi/_vystraha', Object.assign({}, it, { v: it.pocasi.vystrahy[0] })) %><% } %>
  <% var vychozi = it.vzhled && it.vzhled.pocasiZobrazeni === 'hodiny' ? 'hodiny' : 'dny' %>
  <% /* příští hodiny po dvou (24 h); CSS ukáže, kolik se vejde */ %>
  <% var hod = [], posl = ted.getTime() %>
  <% s.hodiny.forEach(function (x) { if (x.symbol && hod.length < 12 && x.cas.getTime() - posl >= 2 * 3600e3 - 60e3) { hod.push(x); posl = x.cas.getTime(); } }) %>
  <div class="poc-prepinac" role="group" aria-label="<%= it.t('pocasi.prepinac') %>" hidden>
    <button type="button" data-pohled="dny" aria-pressed="<%= vychozi === 'dny' %>"><%= it.t('pocasi.dny') %></button>
    <button type="button" data-pohled="hodiny" aria-pressed="<%= vychozi === 'hodiny' %>"><%= it.t('pocasi.hodiny') %></button>
  </div>
  <h2 id="<%= it.idp %>-h"><%= it.t('pocasi.nadpis_dlazdice') %> <span class="poc-misto"><%= s.nazev %></span></h2>
  <% const pm = s.podminky, cast = [] %>
  <% if (pm.vyska !== null) cast.push(it.t('pocasi.vyska', { n: pm.vyska })) %>
  <% if (pm.tlak !== null) cast.push(it.t('pocasi.tlak', { n: pm.tlak }) + (pm.tlakTrend ? ', ' + it.t('pocasi.tlak_trend_' + pm.tlakTrend.replace(/-/g, '_')) : '')) %>
  <% if (pm.vlhkost !== null) cast.push(it.t('pocasi.vlhkost', { n: pm.vlhkost })) %>
  <% if (pm.smerVetru) cast.push(it.t('pocasi.vitr_od', { smer: pm.smerVetru })) %>
  <% if (cast.length) { %><p class="poc-meta"><%= cast.join(' · ') %></p><% } %>
  <%~ include('/pocasi/_astro', it) %>
  <div class="poc-obsah">
    <div class="poc-dnes">
      <picture><source srcset="/static/img/pocasi/anim/<%= h.symbol || 'cloudy' %>.svg" media="(prefers-reduced-motion: no-preference)"><img src="/static/img/pocasi/<%= h.symbol || 'cloudy' %>.svg" alt="" width="80" height="80"></picture>
      <div>
        <p class="poc-den-nazev"><%= it.t('pocasi.ted') %></p>
        <p class="poc-teplota"><%= it.fmtTeplota(h.teplota) %></p>
        <p class="poc-popis"><%= h.popis %></p>
        <% if (dnes) { %><p class="poc-detail"><%= it.t('pocasi.dnes') %>: <%= it.t('pocasi.max_min', { max: it.fmtTeplota(dnes.max), min: it.fmtTeplota(dnes.min) }) %><br><%= it.t('pocasi.srazky') %> <%= it.fmtSrazky(dnes.srazky) %> · <%= it.t('pocasi.vitr') %> <%= it.t('pocasi.vitr_hodnota', { n: dnes.vitrMax === null ? '–' : dnes.vitrMax }) %></p><% } %>
      </div>
    </div>
    <ul class="poc-dalsi" data-pohled="dny"<%= vychozi === 'dny' ? '' : ' hidden' %>>
      <% /* až 6 dalších dní; kolik se jich vejde, ukáže CSS (řádek s pevnou výškou, co se zalomí, je skryté) */ %>
      <% dny.slice(1, 7).forEach(function (d) { %>
      <li>
        <p class="poc-den-nazev"><%= it.nazevDne(d, ted, it.t) %></p>
        <img src="/static/img/pocasi/<%= d.symbol %>.svg" alt="<%= d.popis %>" width="52" height="52">
        <p class="poc-maxmin"><span class="vh"><%= it.t('pocasi.nejvys') %> </span><strong><%= it.fmtTeplota(d.max) %></strong> <span class="vh"><%= it.t('pocasi.nejniz') %> </span><span class="poc-min"><%= it.fmtTeplota(d.min) %></span></p>
        <p class="poc-detail"><span class="vh"><%= it.t('pocasi.srazky') %> </span><%= it.fmtSrazky(d.srazky) %></p>
      </li>
      <% }) %>
    </ul>
    <ul class="poc-dalsi poc-hodiny" data-pohled="hodiny"<%= vychozi === 'hodiny' ? '' : ' hidden' %>>
      <% hod.forEach(function (x) { %>
      <li>
        <p class="poc-den-nazev"><%= it.fmtHodina(x.cas) %></p>
        <img src="/static/img/pocasi/<%= x.symbol %>.svg" alt="<%= x.popis %>" width="52" height="52">
        <p class="poc-maxmin"><strong><%= it.fmtTeplota(x.teplota) %></strong></p>
        <p class="poc-detail"><span class="vh"><%= it.t('pocasi.srazky') %> </span><%= it.fmtSrazky(x.srazky) %></p>
      </li>
      <% }) %>
    </ul>
  </div>
  <p class="poc-dal"><a href="/pocasi"><%= it.t('pocasi.na_7_dni') %> <span aria-hidden="true">›</span></a>
    <span class="poc-zdroj"><%= it.t('pocasi.zdroj') %><% if (s.aktualizovano) { %> · <%= it.t('pocasi.aktualizovano', { kdy: it.fmtHodina(s.aktualizovano) }) %><% } %></span></p>
</section>
<script src="/static/js/pocasi-scena.js?v=<%= it.v %>" defer></script>
