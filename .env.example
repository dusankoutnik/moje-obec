# Moje obec 2.0 — tajná a instalační konfigurace (zkopírujte do .env; .env NIKDY nepatří do gitu)
# Veřejná adresa instalace (bez lomítka na konci). Z ní se odvozuje OIDC issuer (<BASE_URL>/oidc).
BASE_URL=http://localhost:3000
# Adresa, na které aplikace sama sebe dosáhne (OIDC token endpoint). Prázdné = BASE_URL.
INTERNAL_BASE_URL=http://127.0.0.1:3000
PORT=3000
HOST=0.0.0.0
# Docker obraz nastavuje NODE_ENV=production sám. Jen pro lokální vývoj (npm run dev) odkomentujte:
# NODE_ENV=development
LOG_LEVEL=info
# Vývojová/testovací instalace: 1 = X-Robots-Tag noindex a robots.txt zakazuje vše (produkce: nechat prázdné)
ROBOTS_NOINDEX=
# Postgres
DATABASE_URL=postgres://platforma:heslo@localhost:5432/platforma
# Tajné klíče — vygenerujte: openssl rand -hex 32 (každý jiný!)
SESSION_SECRET=
OIDC_COOKIE_SECRET=
OIDC_PLATFORMA_SECRET=
# Profil obce
OBEC_YML=./obec.yml
# Nahrané soubory obce (přílohy, obrázky) — v Dockeru pojmenovaný volume
DATA_DIR=./data
# SMS: konzole | smsgate | smsbrana | gosms | smsmanager
# konzole = nic se neposílá (vývoj); ostrá instalace (NODE_ENV=production) s konzolí odmítne start
SMS_PROVIDER=konzole
SMS_ODESILATEL=
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1/message
SMSGATE_USER=
SMSGATE_PASS=
SMSBRANA_LOGIN=
SMSBRANA_PASSWORD=
GOSMS_CLIENT_ID=
GOSMS_CLIENT_SECRET=
GOSMS_CHANNEL=
SMSMANAGER_APIKEY=
SMSMANAGER_WEBHOOK_SECRET=
# Tajná část adresy webhooku doručenek <BASE_URL>/webhook/sms/<token> (openssl rand -hex 24); prázdné = ze SESSION_SECRET
SMS_WEBHOOK_TOKEN=
# E-mail: konzole | smtp
MAIL_PROVIDER=konzole
MAIL_FROM="Obec <obec@example.cz>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
# Vývoj/testovací instalace: ukázat SMS kód přímo na stránce (jde jen s SMS_PROVIDER=konzole; na ostré instalaci 0)
OTP_DEV_ZOBRAZIT=0
# Tempo rozesílky infokanálu (ms mezi SMS, min–max; e-maily)
IK_SMS_INTERVAL_MIN_MS=1000
IK_SMS_INTERVAL_MAX_MS=3000
IK_EMAIL_INTERVAL_MS=500
