{
  "name": "moje-obec-platforma",
  "version": "0.1.0",
  "description": "Moje obec 2.0 — otevřená platforma pro weby a služby malých českých obcí",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:pokryti": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.1.4",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.6",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/genos": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/rubik-dirt": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/ubuntu": "^5.3.0",
    "croner": "^9.1.0",
    "dotenv": "^17.2.3",
    "eta": "^3.5.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.1",
    "file-type": "^22.2.0",
    "jose": "^6.1.0",
    "kysely": "^0.28.8",
    "nodemailer": "^10.1.7",
    "oidc-provider": "^9.5.2",
    "openid-client": "^6.8.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "quill": "^2.0.3",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.18.9",
    "@types/nodemailer": "^7.0.2",
    "@types/oidc-provider": "^9.5.1",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}
